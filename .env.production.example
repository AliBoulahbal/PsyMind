ENVIRONMENT=production
APP_NAME=PsyMind V3 Clinical
PUBLIC_HOST=psymind.example.com

# Generate unique values. Never commit the real .env.production.
SECRET_KEY=REPLACE_WITH_64_PLUS_RANDOM_CHARS
POSTGRES_DB=psymind
POSTGRES_OWNER=psymind_owner
POSTGRES_OWNER_PASSWORD=REPLACE_OWNER_PASSWORD
POSTGRES_APP=psymind_app
POSTGRES_APP_PASSWORD=REPLACE_APP_PASSWORD

# API runtime MUST use the non-owner/NOBYPASSRLS role.
DATABASE_URL=postgresql+asyncpg://psymind_app:REPLACE_APP_PASSWORD@db:5432/psymind
MIGRATION_DATABASE_URL=postgresql+asyncpg://psymind_owner:REPLACE_OWNER_PASSWORD@db:5432/psymind

REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0

MINIO_ACCESS_KEY=REPLACE_MINIO_ACCESS
MINIO_SECRET_KEY=REPLACE_MINIO_SECRET
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=clinical-documents

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://psymind.example.com

LLM_PROVIDER=ollama
LLM_API_KEY=
EMBEDDING_PROVIDER=sentence_transformers

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_TOP_K=8
RAG_CANDIDATE_K=20
MAX_UPLOAD_MB=20
PII_ENCRYPTION_KEY=CHANGE_ME_64_CHARS_MINIMUM
AI_FAIL_OPEN=false
EXTERNAL_AUDIT_URL=
EXTERNAL_AUDIT_TOKEN=
